{
  "lexicon": 1,
  "id": "com.example.cooklog.comment",
  "defs": {
    "main": {
      "type": "record",
      "description": "A comment on a cook or a visit. Comments are flat, not threaded.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["subject", "text", "createdAt"],
        "properties": {
          "subject": {
            "type": "ref",
            "ref": "com.atproto.repo.strongRef",
            "description": "The cook or visit record being commented on."
          },
          "text": {
            "type": "string",
            "minGraphemes": 1,
            "maxGraphemes": 500,
            "maxLength": 5000
          },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
