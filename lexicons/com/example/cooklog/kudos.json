      "type": "record",
      "description": "Kudos from the author on a cook or a visit.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["subject", "createdAt"],
        "properties": {
          "subject": {
            "type": "ref",
            "ref": "com.atproto.repo.strongRef",
            "description": "The cook or visit record being given kudos."
          },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
