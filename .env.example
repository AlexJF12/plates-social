# Copy to .env.local and fill in. Next.js, the scripts and scripts/tap.sh all read .env.local.

# Postgres (docker compose up -d)
DATABASE_URL=postgres://cooklog:cooklog@127.0.0.1:5432/cooklog

# Signs the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Tap
TAP_URL=http://127.0.0.1:2480
# Shared by Tap (--admin-password) and the app (webhook auth + /repos/add). openssl rand -hex 16
TAP_ADMIN_PASSWORD=

# --- Tunnel / phone testing only. Leave both empty for plain localhost dev. ---
# Public HTTPS origin of the tunnel, no trailing slash, e.g. https://abc-123.trycloudflare.com
# When set, the app acts as a confidential OAuth client instead of the loopback client.
PUBLIC_URL=
# Private signing key (JWK JSON on one line). Generate with: pnpm gen-key
PRIVATE_KEY=
